<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.common.mapper.ChatRoomMapper">

    <!-- 채팅방 생성 -->
    <insert id="insertChatRoom" parameterType="com.example.backend.common.model.ChatRoom">
        INSERT INTO chat_rooms (name, createdBy, createdAt)
        VALUES (#{name}, #{createdBy}, #{createdAt})
        <selectKey keyProperty="id" resultType="long" order="AFTER">
            SELECT LAST_INSERT_ID()
        </selectKey>
    </insert>

    <!-- 특정 채팅방 조회 -->
    <select id="selectChatRoomById" resultType="com.example.backend.common.model.ChatRoom">
        SELECT id, name, createdBy, createdAt
        FROM chat_rooms
        WHERE id = #{id}
    </select>

    <!-- 모든 채팅방 목록 조회 (옵션) -->
    <select id="selectAllChatRooms" resultType="com.example.backend.common.model.ChatRoom">
        SELECT id, name, createdBy, createdAt
        FROM chat_rooms
        ORDER BY createdAt DESC
    </select>

</mapper>
