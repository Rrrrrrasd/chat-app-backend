<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.backend.common.mapper.FriendshipMapper">

    <resultMap id="FriendshipModelResultMap" type="com.example.backend.common.model.FriendshipModel">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="friendId" column="friend_id"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- ID 기준 단건 조회 (사용 안 하면 제거 가능) -->
    <select id="selectFriendshipById" parameterType="long" resultMap="FriendshipModelResultMap">
        SELECT * FROM FRIENDSHIP WHERE id = #{id}
    </select>

    <!-- 사용자 ID 기준 전체 관계 조회 -->
    <select id="selectFriendshipsByUserId" parameterType="long" resultMap="FriendshipModelResultMap">
        SELECT * FROM FRIENDSHIP
        WHERE user_id = #{userId}
    </select>

    <!-- 사용자와 친구 관계 단건 조회 -->
    <select id="selectFriendship" resultMap="FriendshipModelResultMap">
        SELECT * FROM FRIENDSHIP
        WHERE (user_id = #{userId} AND friend_id = #{friendId})
           OR (user_id = #{friendId} AND friend_id = #{userId})
    </select>

    <!-- 상태별 친구 조회 (ACCEPTED) -->
    <select id="selectAcceptedFriendships" parameterType="long" resultMap="FriendshipModelResultMap">
        SELECT * FROM FRIENDSHIP
        WHERE status = 'ACCEPTED'
          AND (user_id = #{userId} OR friend_id = #{userId})
    </select>

    <!-- 내가 받은 친구 요청 (PENDING) -->
    <select id="selectPendingRequests" parameterType="long" resultMap="FriendshipModelResultMap">
        SELECT * FROM FRIENDSHIP
        WHERE friend_id = #{userId}
          AND status = 'PENDING'
    </select>

    <!-- 내가 차단한 사용자 목록 (BLOCKED) -->
    <select id="selectBlockedFriendships" parameterType="long" resultMap="FriendshipModelResultMap">
        SELECT * FROM FRIENDSHIP
        WHERE user_id = #{userId}
          AND status = 'BLOCKED'
    </select>

    <select id="selectBlockedRelation" resultMap="FriendshipModelResultMap">
        SELECT * FROM FRIENDSHIP
        WHERE (
            (user_id = #{userId1} AND friend_id = #{userId2})
                OR
            (user_id = #{userId2} AND friend_id = #{userId1})
            )
          AND status = 'BLOCKED'
    </select>

    <insert id="insertFriendship" parameterType="com.example.backend.common.model.FriendshipModel" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO FRIENDSHIP (user_id, friend_id, status, created_at, updated_at)
        VALUES (#{userId}, #{friendId}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="updateFriendship" parameterType="com.example.backend.common.model.FriendshipModel">
        UPDATE FRIENDSHIP
        SET status = #{status},
            updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <delete id="deleteFriendship" parameterType="long">
        DELETE FROM FRIENDSHIP WHERE id = #{id}
    </delete>



</mapper>
