<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.common.mapper.UserMapper">
    <select id="selectUserByUsername" resultType="com.example.backend.common.model.UserModel">
        SELECT * FROM users WHERE username = #{username}
    </select>

    <insert id="insertUser" parameterType="com.example.backend.common.model.UserModel">
        INSERT INTO users (username, password, nickname)
        VALUES (#{username}, #{password}, #{nickname})
    </insert>



</mapper>